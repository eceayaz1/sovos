<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_tr_sovos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n_tr_sovos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_tr_nilvera.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='l10n_tr_nilvera_settings']" position="after">
                <block title="Sovos e-Fatura" id="l10n_tr_sovos_settings" invisible="country_code != 'TR'">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_right_pane border-0">
                            <div class="text-muted mb-3">
                                Sovos (FIT) e-Fatura web servis bilgileri. Kullanıcı adı ve şifre girildiğinde
                                e-Faturalar Nilvera yerine Sovos üzerinden gönderilir ve alınır.
                            </div>
                            <div class="row">
                                <label string="Web Servis Kullanıcı Adı" for="l10n_tr_sovos_username" class="col-lg-3 o_light_label"/>
                                <field name="l10n_tr_sovos_username"/>
                            </div>
                            <div class="row">
                                <label string="Web Servis Şifresi" for="l10n_tr_sovos_password" class="col-lg-3 o_light_label"/>
                                <field name="l10n_tr_sovos_password" password="True"/>
                            </div>
                            <div class="row">
                                <label string="Gönderici Birim (GB)" for="l10n_tr_sovos_gb_alias" class="col-lg-3 o_light_label"/>
                                <field name="l10n_tr_sovos_gb_alias" placeholder="urn:mail:defaultgb@firma.com.tr"/>
                            </div>
                            <div class="row">
                                <label string="Posta Kutusu (PK)" for="l10n_tr_sovos_pk_alias" class="col-lg-3 o_light_label"/>
                                <field name="l10n_tr_sovos_pk_alias" placeholder="urn:mail:defaultpk@firma.com.tr"/>
                            </div>
                            <div class="row">
                                <label string="Gelen Fatura Yevmiyesi" for="l10n_tr_sovos_purchase_journal_id" class="col-lg-3 o_light_label"/>
                                <field name="l10n_tr_sovos_purchase_journal_id"/>
                            </div>
                            <div class="row">
                                <label string="Son Gelen Fatura Sorgusu" for="l10n_tr_sovos_last_fetch_date" class="col-lg-3 o_light_label"/>
                                <field name="l10n_tr_sovos_last_fetch_date"/>
                            </div>
                            <div class="mt16" invisible="not l10n_tr_sovos_username">
                                <button name="action_l10n_tr_sovos_test_connection" type="object" class="btn-link">
                                    <i title="Bağlantıyı test et" role="img" aria-label="Bağlantıyı test et" class="fa fa-plug fa-fw"/>
                                    Bağlantıyı Test Et / Etiketleri Getir
                                </button>
                                <button name="action_l10n_tr_sovos_fetch_incoming" type="object" class="btn-link">
                                    <i title="Gelen faturaları al" role="img" aria-label="Gelen faturaları al" class="fa fa-download fa-fw"/>
                                    Gelen Faturaları Şimdi Al
                                </button>
                            </div>
                            <setting id="l10n_tr_sovos_use_test_env" class="mt-3"
                                     help="efaturawstest.fitbulut.com test ortamını kullanır">
                                <field name="l10n_tr_sovos_use_test_env"/>
                            </setting>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
