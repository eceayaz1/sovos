<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_tr_sovos_app_response_wizard_form" model="ir.ui.view">
        <field name="name">l10n_tr.sovos.app.response.wizard.form</field>
        <field name="model">l10n_tr.sovos.app.response.wizard</field>
        <field name="arch" type="xml">
            <form string="Ticari Fatura Yanıtı">
                <div class="alert alert-info" role="alert">
                    Ticari faturalara fatura tarihinden itibaren 8 gün içinde yanıt verilmelidir. Yanıt geri alınamaz.
                </div>
                <group>
                    <field name="move_id"/>
                    <field name="response_code" widget="radio" options="{'horizontal': true}"/>
                    <field name="note" required="response_code == 'RED'"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Gönder" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
